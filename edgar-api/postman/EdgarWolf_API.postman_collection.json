    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health \u2014 ok",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has status field', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('status');",
                  "  pm.expect(['ok','degraded']).to.include(b.status);",
                  "});",
                  "pm.test('response under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        }
      ]
    },
