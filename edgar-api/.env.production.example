# edgar-api production environment example
# Set these values in your deployment platform (do not commit real secrets/config).

# Comma-separated browser origins allowed by CORS.
CORS_ALLOW_ORIGINS=https://app.example.com,https://www.example.com

# Preferred: full SEC-compliant identity string.
SEC_USER_AGENT=edgar-api/1.0 jason@edgarwolf.com

# Optional fallback if SEC_USER_AGENT is not set.
SEC_APP_NAME=edgar-api/1.0
SEC_CONTACT_EMAIL=jason.ostergren79@gmail.com

# Enforce explicit SEC identity in production.
SEC_REQUIRE_EXPLICIT_USER_AGENT=true

# Upstream SEC request hardening knobs.
SEC_HTTP_TIMEOUT_SECONDS=20
SEC_HTTP_MAX_RETRIES=3
SEC_HTTP_RETRY_BASE_SECONDS=0.5

# Outbound SEC rate limiter: max requests per second (token-bucket).
# Stay well below SEC's 10 req/s ceiling. Default 4 is conservative.
SEC_RATE_LIMIT_RPS=4

# Seconds to pause all outbound SEC fetches after receiving a 429 response.
SEC_429_COOLDOWN_SECONDS=30
