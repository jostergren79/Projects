{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Server (Pro)",
      "type": "shell",
      "command": "${workspaceFolder}/dev.sh pro",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Waiting for server",
          "endsPattern": "Opening http"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Start Dev Server (Standard)",
      "type": "shell",
